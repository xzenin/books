{
  "bookRootFiles": [
    "Settings.json",
    "BookPrompt.txt",
    "BookOutline.json",
    "BookRunningSummary.txt",
    "BookPublished.txt"
  ],
  "chapters": {
    "start": 1,
    "end": 20,
    "chapterFolderPattern": "Chapter{n}",
    "chapterFiles": [
      "ChapterParameter.json",
      "ChapterPrompt.txt"
    ],
    "chapterOutFolderPattern": "ChapterOut",
    "segments": {
      "start": 1,
      "end": 5,
      "segmentFolderPattern": "ChapterSegments/Segment{s}",
      "segmentFiles": [
        "SegmentParameter.json",
        "SegmentPrompt.txt"
      ],
      "segmentOutFolderPattern": "SegmentOut",
      "segmentOutFiles": [
        "SegmentSummary.txt",
        "SegmentCharacter.txt",
        "SegmentGenerated.txt"
      ]
    },
    "chapterOutFiles": [
      "ChapterSummary.txt",
      "ChapterCharacter.txt",
      "ChapterGenerated.txt"
    ]
  }
}
